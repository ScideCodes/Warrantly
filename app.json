{
  "expo": {
    "name": "Warrantly",
    "slug": "warrantly",
    "scheme": "warrantly",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.warrantly.app"
    },
    "android": {
      "package": "dev.warrantly.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": [
            "en",
            "hu"
          ]
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "react-native-document-scanner-plugin",
      "expo-sharing",
      "expo-mail-composer",
      "expo-calendar",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextExpiry",
              "label": "Warrantly",
              "description": "Warranties ending soon, return deadlines and quick actions",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 10800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ]
        }
      ],
      "expo-status-bar",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*",
            "application/pdf",
            "message/rfc822",
            "text/plain"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Warrantly uses your photos to add a picture of a product.",
          "cameraPermission": "Warrantly uses the camera to photograph a product.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Warrantly uses the camera to read a serial number or barcode.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withShortcuts",
      "./plugins/withNoDataExtraction"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "scide-warrantly",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9e085868-1858-4d15-bfab-c596c6a222ab",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "extra": {
      "eas": {
        "projectId": "9e085868-1858-4d15-bfab-c596c6a222ab"
      }
    }
  }
}
