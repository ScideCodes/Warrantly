{
  "expo": {
    "name": "Warrantly",
    "slug": "warrantly",
    "scheme": "warrantly",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.warrantly.prototype"
    },
    "android": {
      "package": "dev.warrantly.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": [
            "en",
            "hu"
          ]
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "react-native-document-scanner-plugin",
      "expo-sharing",
      "expo-mail-composer",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextExpiry",
              "label": "Warrantly",
              "description": "The next warranty to expire",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 10800000
            }
          ]
        }
      ],
      "expo-status-bar",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*",
            "application/pdf"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "scide-warrantly",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9e085868-1858-4d15-bfab-c596c6a222ab"
    },
    "extra": {
      "eas": {
        "projectId": "9e085868-1858-4d15-bfab-c596c6a222ab"
      }
    }
  }
}
