{
  "expo": {
    "name": "Warrantly",
    "slug": "warrantly",
    "scheme": "warrantly",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.warrantly.prototype"
    },
    "android": {
      "package": "dev.warrantly.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": [
            "en",
            "hu"
          ]
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "scide-warrantly",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9e085868-1858-4d15-bfab-c596c6a222ab"
    },
    "extra": {
      "eas": {
        "projectId": "9e085868-1858-4d15-bfab-c596c6a222ab"
      }
    }
  }
}
