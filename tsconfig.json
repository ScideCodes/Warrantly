{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // src/parser and src/mail import with ".ts" so `node --test` can run them without a build step
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
