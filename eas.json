{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      }
    },
    "emulator": {
      "extends": "preview",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "x86_64"
      }
    }
  }
}
